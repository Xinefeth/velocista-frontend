# Desarrollo local: proxy Vite al backend (no se incluye en el build público).
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# Mismo dominio: /api. Dos dominios: https://TU-BACKEND/api.
# Configurar ANTES de npm run build; Vite incorpora estos valores al compilar.
VITE_API_BASE_URL=/api

# Vacío: se deriva del dominio del backend. En HTTPS se usará wss://.
# Ejemplo explícito: wss://TU-BACKEND/ws/console
VITE_WS_URL=
